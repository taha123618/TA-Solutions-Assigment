{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd ta-solution-backend && npm install && npm run build"
  },
  "deploy": {
    "startCommand": "cd ta-solution-backend && npm run start:prod",
    "healthcheckPath": "/api/currency/currencies",
    "restartPolicyType": "ON_FAILURE"
  }
}